{
  "name": "@lll9p/pi-anyrouter",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Unofficial pi provider extension for AnyRouter Claude Code and Codex Responses Lite routes",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "anyrouter",
    "claude",
    "claude-code",
    "codex",
    "openai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lll9p/pi-anyrouter.git"
  },
  "homepage": "https://github.com/lll9p/pi-anyrouter#readme",
  "bugs": {
    "url": "https://github.com/lll9p/pi-anyrouter/issues"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "check": "tsc --noEmit && biome check src/",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "undici": "^8.10.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.0"
  }
}
